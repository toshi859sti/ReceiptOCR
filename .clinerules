### データベーススキーマ

#### product_master テーブル
```sql
CREATE TABLE product_master (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    canonical_name TEXT NOT NULL,
    category TEXT NOT NULL,
    frequency_count INTEGER DEFAULT 0,
    yayoi_account_id INTEGER,
    rakuraku_account_id INTEGER,
    FOREIGN KEY (yayoi_account_id) REFERENCES yayoi_accounts(id),
    FOREIGN KEY (rakuraku_account_id) REFERENCES rakuraku_accounts(id)
);
```

#### ocr_variants テーブル
```sql
CREATE TABLE ocr_variants (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    product_id INTEGER NOT NULL,
    variant_text TEXT NOT NULL,
    occurrence_count INTEGER DEFAULT 0,
    last_seen DATETIME,
    FOREIGN KEY (product_id) REFERENCES product_master(id) ON DELETE CASCADE
);
```

#### yayoi_accounts テーブル
```sql
CREATE TABLE yayoi_accounts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    account_code TEXT NOT NULL UNIQUE,
    account_name TEXT NOT NULL,
    category TEXT,
    subcategory TEXT,
    description TEXT
);
```

#### rakuraku_accounts テーブル
```sql
CREATE TABLE rakuraku_accounts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    account_code TEXT NOT NULL UNIQUE,
    account_name TEXT NOT NULL,
    category TEXT,
    subcategory TEXT,
    description TEXT
);
```

