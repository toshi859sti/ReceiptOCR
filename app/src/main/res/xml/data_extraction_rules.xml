<?xml version="1.0" encoding="utf-8"?>
<!-- API 31 以上の自動バックアップ／端末間転送設定。APIキーを含む秘匿prefsを除外する -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="receipt_ocr_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="receipt_ocr_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
